# ==========================================
# ⚙️ BANCO DE DADOS — SUPABASE
# ==========================================
# Cole aqui a connection string do Supabase
# Vá em: Project Settings > Database > Connection string > URI
# Use a connection string de "Transaction pooler" (porta 6543) para produção
# ou a "Session pooler" / conexão direta (porta 5432) para desenvolvimento
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ==========================================
# 🧠 INTEGRAÇÃO DE INTELIGÊNCIA ARTIFICIAL
# ==========================================
GEMINI_API_KEY=insira_sua_chave_da_google_aqui
AUDIO_UPLOAD_DIR=uploads/audio


SMTP_EMAIL=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_smtp
TEST_USER_EMAIL=dev@looptone.com
